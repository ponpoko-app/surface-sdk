{
  "name": "@ponpoko/surface-sdk",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Public Ponpoko surface contracts, frame client, Host AI adapters and compatibility checks",
  "engines": { "node": ">=24" },
  "exports": {
    "./ci-contract": { "types": "./ci-contract.d.mts", "default": "./ci-contract.mjs" },
    "./package-contract": { "types": "./package-contract.d.mts", "default": "./package-contract.mjs" },
    "./release-contract": { "types": "./release-contract.d.mts", "default": "./release-contract.mjs" },
    ".": { "types": "./surface.d.mts", "default": "./surface.mjs" },
    "./ai": { "types": "./host-ai.d.mts", "default": "./host-ai.mjs" },
    "./research/backend": { "types": "./research.backend.d.mts", "default": "./research.backend.mjs" },
    "./backend": { "types": "./host-ai.backend.d.mts", "default": "./host-ai.backend.mjs" },
    "./protocol": { "types": "./protocol.ts", "default": "./protocol.mjs" }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:ci": "node scripts/build-ci-fixtures.mjs --check",
    "check:surface": "node scripts/check-surface.mjs",
    "copy:ai": "node scripts/copy-ai-assets.mjs"
  }
}
