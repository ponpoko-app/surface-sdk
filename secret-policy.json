{
  "version": 1,
  "placeholders": [
    "",
    "example",
    "placeholder",
    "redacted",
    "test-key",
    "test-token",
    "changeme",
    "<YOUR_API_KEY>",
    "YOUR_API_KEY"
  ],
  "rules": [
    {
      "id": "private_key",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----[\\r\\n]+[A-Za-z0-9+/=\\r\\n]{32,}"
    },
    {
      "id": "provider_token",
      "pattern": "\\b(?:sk-(?:proj-|ant-api\\d+-)?[A-Za-z0-9_-]{20,}|pko_(?:at|rt)_[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|(?:AKIA|ASIA)[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{20,})\\b"
    },
    {
      "id": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b"
    },
    {
      "id": "credential_url",
      "pattern": "https?://[^\\s/:@]+:[^\\s/@]+@"
    },
    {
      "id": "credential_literal",
      "insensitive": true,
      "capture": 1,
      "pattern": "\\b[a-z0-9_]*(?:api[_-]?key|partner[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|signing[_-]?key|private[_-]?key|password|authorization)[\"'`]?\\s*[:=]\\s*[\"'`]([^\"'`\\r\\n]*)[\"'`]"
    },
    {
      "id": "bearer_literal",
      "insensitive": true,
      "capture": 1,
      "pattern": "\\bBearer ([A-Za-z0-9._~+/-]{12,}=*)"
    },
    {
      "id": "credential_parameter",
      "insensitive": true,
      "capture": 1,
      "pattern": "[?&](?:api[_-]?key|partner[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|password|signature|x-amz-signature)=([^&#\\s\\\"'`<>]+)"
    }
  ]
}
