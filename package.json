{
  "name": "@ponpoko-app/surface-sdk",
  "version": "1.3.2",
  "type": "module",
  "description": "Build Ponpoko surfaces with a pinned starter, native controls and the typed Host broker.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ponpoko-surface": "./bin/ponpoko-surface.mjs"
  },
  "exports": {
    ".": {
      "types": "./surface.d.mts",
      "default": "./surface.mjs"
    },
    "./ai": {
      "types": "./host-ai.d.mts",
      "default": "./host-ai.mjs"
    },
    "./research/backend": {
      "types": "./research.backend.d.mts",
      "default": "./research.backend.mjs"
    },
    "./backend": {
      "types": "./host-ai.backend.d.mts",
      "default": "./host-ai.backend.mjs"
    },
    "./protocol": {
      "types": "./protocol.ts",
      "default": "./protocol.mjs"
    },
    "./theme": {
      "types": "./theme.d.mts",
      "default": "./theme.mjs"
    },
    "./ui": {
      "types": "./ui/index.d.mts",
      "default": "./ui/index.mjs"
    },
    "./build": {
      "types": "./build.d.mts",
      "default": "./build.mjs"
    },
    "./testing": {
      "types": "./testing.d.mts",
      "default": "./testing.mjs"
    },
    "./storage": {
      "types": "./storage.d.mts",
      "default": "./storage.mjs"
    },
    "./tokens.css": "./ui/tokens.css",
    "./components.css": "./ui/components.css",
    "./ai-contract.json": "./ai-contract.json",
    "./broker-contract.json": "./broker-contract.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:ci": "node scripts/build-ci-fixtures.mjs --check",
    "check:surface": "node scripts/check-surface.mjs",
    "copy:ai": "node scripts/copy-ai-assets.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponpoko-app/surface-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "README.md",
    "SKILL.md",
    "starter",
    "ui",
    "bin/ponpoko-surface.mjs",
    "build.*",
    "testing.*",
    "storage.*",
    "scripts/check-surface.mjs",
    "scripts/secrets.mjs",
    "secret-policy.json",
    "surface.*",
    "wait.mjs",
    "theme.*",
    "host-operations.d.mts",
    "host-ai*.mjs",
    "host-ai.d.mts",
    "host-ai.backend.d.mts",
    "protocol.*",
    "platform-types.d.ts",
    "work-*.d.ts",
    "research.*",
    "ai-contract.json",
    "broker-contract.json"
  ]
}
